# Local development database (compose.dev.yaml). The full stack uses host db.
DATABASE_URL=postgres://bay:bay@localhost:5432/baywatchers
# Public origin: https://localhost:8443 for nginx, http://localhost:5173 for pnpm dev.
ORIGIN=https://localhost:8443
# Required in production when development login is disabled.
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# Development login is allowed only with localhost or 127.0.0.1 as ORIGIN.
AUTH_DEV_LOGIN=true
# Optional TV access token: empty or at least 24 characters.
DISPLAY_TOKEN=
# Optional TV redirect; empty disables it.
DISPLAY_REDIRECT_URL=
DISPLAY_REDIRECT_SECONDS=30
# All calendar rules use this timezone.
TZ=Europe/Rome
# adapter-node behind nginx (one trusted proxy).
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
# Maximum request body size.
BODY_SIZE_LIMIT=2M
# Local database credentials for compose.yaml.
POSTGRES_USER=bay
POSTGRES_PASSWORD=bay
POSTGRES_DB=baywatchers
